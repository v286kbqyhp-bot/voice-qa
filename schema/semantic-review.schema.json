{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_sha256",
    "reviewer",
    "dialogue",
    "criteria",
    "receipt_fields",
    "summary"
  ],
  "properties": {
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "receipt_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_ids",
          "speaker",
          "text",
          "certainty",
          "rationale"
        ],
        "properties": {
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "speaker": {
            "enum": [
              "测试输入",
              "设备回复",
              "不明说话人"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "certainty": {
            "enum": [
              "有字幕支持",
              "服务端原文",
              "推测还原",
              "无法确定"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "reason",
          "segment_ids",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "blocked",
              "not_run"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
